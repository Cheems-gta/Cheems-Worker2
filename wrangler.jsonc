{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "silent-flower-7f86",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "keep_vars": true,
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "run_worker_first": [
      "/",
      "/health",
      "/test",
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "TRANSLATE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
